<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_color" value="Gazebo/Silver" />


    <!--mu1, mu2: 접촉면 마찰계수(서로 직각)
        kq:접촉 강성 kd: 감쇄 계수(스프링처럼)-->

  <gazebo reference="base_link">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <gravity>true</gravity>
  </gazebo>


  <gazebo reference="fl_leg4_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <contact>
      <!-- 엔진별 지원항목이 다르지만 아래 조합이 대체로 잘 먹음 -->
      <ode>
        <kp>5e6</kp>         <!-- 관통시 복원 강성 (너무 크면 튀어요) -->
        <kd>1.0</kd>         <!-- 접촉 감쇠 -->
        <min_depth>0.01</min_depth> <!-- 허용 관통: 작은 deadzone 효과 -->
        <max_vel>0.05</max_vel>       <!-- 해석기 안정화에 도움 -->
        <soft_cfm>1e-6</soft_cfm>
        <soft_erp>0.2</soft_erp>
      </ode>
    </contact>
  </gazebo>

  <gazebo reference="fr_leg4_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <contact>
      <!-- 엔진별 지원항목이 다르지만 아래 조합이 대체로 잘 먹음 -->
      <ode>
        <kp>5e6</kp>         <!-- 관통시 복원 강성 (너무 크면 튀어요) -->
        <kd>1.0</kd>         <!-- 접촉 감쇠 -->
        <min_depth>0.01</min_depth> <!-- 허용 관통: 작은 deadzone 효과 -->
        <max_vel>0.05</max_vel>       <!-- 해석기 안정화에 도움 -->
        <soft_cfm>1e-6</soft_cfm>
        <soft_erp>0.2</soft_erp>
      </ode>
    </contact>
  </gazebo>

  <gazebo reference="rl_leg4_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <contact>
      <!-- 엔진별 지원항목이 다르지만 아래 조합이 대체로 잘 먹음 -->
      <ode>
        <kp>5e6</kp>         <!-- 관통시 복원 강성 (너무 크면 튀어요) -->
        <kd>1.0</kd>         <!-- 접촉 감쇠 -->
        <min_depth>0.01</min_depth> <!-- 허용 관통: 작은 deadzone 효과 -->
        <max_vel>0.05</max_vel>       <!-- 해석기 안정화에 도움 -->
        <soft_cfm>1e-6</soft_cfm>
        <soft_erp>0.2</soft_erp>
      </ode>
    </contact>
  </gazebo>

  <gazebo reference="rr_leg4_1">
    <material>${body_color}</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>100000.0</kp>
    <kd>1.0</kd>
    <contact>
      <!-- 엔진별 지원항목이 다르지만 아래 조합이 대체로 잘 먹음 -->
      <ode>
        <kp>5e6</kp>         <!-- 관통시 복원 강성 (너무 크면 튀어요) -->
        <kd>1.0</kd>         <!-- 접촉 감쇠 -->
        <min_depth>0.01</min_depth> <!-- 허용 관통: 작은 deadzone 효과 -->
        <max_vel>0.05</max_vel>       <!-- 해석기 안정화에 도움 -->
        <soft_cfm>1e-6</soft_cfm>
        <soft_erp>0.2</soft_erp>
      </ode>
    </contact>
  </gazebo>

</robot>
